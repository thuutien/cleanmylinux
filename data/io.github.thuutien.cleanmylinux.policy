<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>CleanMyLinux</vendor>
  <action id="io.github.thuutien.cleanmylinux.helper">
    <description>Clean system files and manage packages</description>
    <message>Authentication is required to clean system files or manage software</message>
    <icon_name>cleanmylinux</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/cleanmylinux/cleanmylinux-helper</annotate>
  </action>
</policyconfig>
