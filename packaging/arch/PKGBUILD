pkgname=cleanmylinux
pkgver=1.1.0
pkgrel=1
pkgdesc="CleanMyMac-style system cleaner, uninstaller and updater for Linux (GTK3)"
arch=('any')
url="https://github.com/thuutien/cleanmylinux"
license=('MIT')
depends=('python' 'python-gobject' 'gtk3' 'python-psutil' 'polkit')
optdepends=('flatpak: list, update and remove Flatpak apps'
            'snapd: list, update and remove Snap packages')
source=("$pkgname-$pkgver.tar.gz::https://github.com/thuutien/cleanmylinux/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('7d759f6527c7c201fef838de6bdaac3a47dd6772d35b6680063212cb1e16af6a')

package() {
  cd "$pkgname-$pkgver"
  sh install.sh --prefix-root "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
